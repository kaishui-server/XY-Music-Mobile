<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- just_audio 使用本机代理为插件音源附加 Referer/Cookie 等请求头。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <!-- 酷狗旧版公开歌单详情接口没有可用的 HTTPS 证书，仅对此域名放行 HTTP。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www2.kugou.kugou.com</domain>
    </domain-config>
    <!-- XY Music 官方服务当前与桌面端一致，直接监听 HTTP 8081。仅对此 IP 放行明文请求。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">156.233.228.213</domain>
    </domain-config>
</network-security-config>
