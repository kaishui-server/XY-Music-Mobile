<?xml version="1.0" encoding="utf-8"?>
<!-- API 28+ 主题副本：追加 windowLayoutInDisplayCutoutMode。华为
     EMUI/HarmonyOS 部分版本忽略 manifest activity 属性形式的 cutout
     声明，沉浸（隐藏状态栏）后挖孔区域被系统填充成黑条；theme 项 +
     MainActivity 运行时 window attributes 双保险，确保窗口延伸进
     挖孔区域（内容连续，无黑条）。低版本（<28）不受影响。 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/xy_window_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
